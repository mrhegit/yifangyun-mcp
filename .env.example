# Template only. The server reads process environment variables and does not automatically load this file.
# HTTP npx launcher (repo scripts/start-npx.mjs) uses scripts/.env by default; see scripts/http.env.example.
# Required Yifangyun OAuth and default identity.
YFY_CLIENT_ID=
YFY_CLIENT_SECRET=
YFY_ENTERPRISE_ID=
YFY_DEFAULT_USER_ID=

# Public Fangcloud defaults. Private deployments may override these URLs.
YFY_API_BASE_URL=https://open.fangcloud.com/api
YFY_OAUTH_BASE_URL=https://open.fangcloud.com

# Capability switch. Remove high-risk toolsets unless they are explicitly needed.
# Available: drive,workspace,inventory,organization,collaboration,mutation,admin,transfer
# Default / browse-only: drive
# Tender profile matrix (transfer is NEVER in the tender default): drive,workspace,inventory
# Example tender: YFY_TOOLSETS=drive,workspace,inventory
YFY_TOOLSETS=drive
# Empty = generic tools only. tender = add tender prompts and require drive,workspace,inventory and at least one workspace.
YFY_WORKFLOW_PROFILES=

# Named identities and business directory boundaries. Workspaces restrict existing Provider permissions; they do not grant access.
YFY_DEFAULT_ACCESS_CONTEXT=default
YFY_ACCESS_CONTEXTS_JSON=[]
# Example:
# YFY_ACCESS_CONTEXTS_JSON=[{"id":"reviewer","user_id":"530","external_enterprise_id":"9"}]
YFY_WORKSPACES_JSON=[]
# Example:
# YFY_WORKSPACES_JSON=[{"id":"tender_public","root_folder_id":"501000715605","access_context":"default","tags":["tender","public-material"]}]

# Provider request controls.
YFY_REQUEST_TIMEOUT_MS=30000
YFY_TOKEN_REFRESH_SKEW_SECONDS=300
YFY_MAX_PAGE_CAPACITY=500
YFY_RETRY_MAX_ATTEMPTS=3
YFY_RETRY_BASE_DELAY_MS=500
YFY_MAX_RETRY_DELAY_MS=30000
YFY_MAX_CONCURRENT_PROVIDER_REQUESTS=40
YFY_MAX_CONCURRENT_REQUESTS_PER_IDENTITY=20

# SQLite inventory state and local content storage. Use persistent writable paths in production.
YFY_STATE_DB=
YFY_INVENTORY_CONCURRENCY=2
YFY_INVENTORY_TTL_SECONDS=604800
YFY_MAX_STATE_BYTES=2147483648
YFY_TEMP_DIR=
YFY_TEMP_FILE_TTL_SECONDS=86400
YFY_MAX_DOWNLOAD_BYTES=268435456
YFY_MAX_TEMP_BYTES=1073741824
YFY_TEXT_PREVIEW_MAX_BYTES=32768
YFY_DOWNLOAD_IDLE_TIMEOUT_MS=30000
YFY_DOWNLOAD_WALL_TIMEOUT_MS=300000
# Download delivery. stdio requires local_path and cannot start staged HTTP. HTTP defaults to staged fetch_url and hides local_path.
# YFY_DOWNLOAD_EXPOSE_LOCAL_PATH=
# YFY_DOWNLOAD_STAGED_HTTP=
# YFY_DOWNLOAD_STAGED_MAX_FETCHES=10
# YFY_DOWNLOAD_STAGED_MAX_CONCURRENT_READS=20
# YFY_DOWNLOAD_STAGED_PUBLIC_BASE_URL=https://mcp.example.com
YFY_ALLOW_PRIVATE_TRANSFER_URLS=disabled
YFY_UPLOAD_ROOT_DIR=

# Transport: stdio or http. Non-loopback HTTP also requires bearer, allowed hosts, and allowed origins.
# HTTP also serves GET /staged/v1/{download_id}/... for yfy_download fetch_url (same auth middleware as /mcp).
YFY_TRANSPORT=stdio
YFY_HTTP_HOST=127.0.0.1
YFY_HTTP_PORT=3000
YFY_HTTP_MAX_SESSIONS=100
YFY_HTTP_SESSION_IDLE_SECONDS=1800
YFY_HTTP_BEARER_TOKEN=
YFY_HTTP_ALLOWED_HOSTS=
YFY_HTTP_ALLOWED_ORIGINS=
YFY_LOG_LEVEL=info

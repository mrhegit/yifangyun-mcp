# Yifangyun OAuth credentials.
YFY_CLIENT_ID=
YFY_CLIENT_SECRET=
YFY_ENTERPRISE_ID=
YFY_DEFAULT_USER_ID=

# Public Fangcloud defaults. Private deployments may override these URLs.
YFY_API_BASE_URL=https://open.fangcloud.com/api
YFY_OAUTH_BASE_URL=https://open.fangcloud.com

# Agent-facing capability sets.
# Available: core,authority,snapshot,evidence,organization,collaboration,mutation,admin,transfer
YFY_TOOLSETS=core,authority,snapshot,evidence,organization
YFY_WORKFLOW_PROFILES=tender

# Named access contexts and authority scopes. Keep credentials out of these values.
YFY_DEFAULT_ACCESS_CONTEXT=default
YFY_ACCESS_CONTEXTS_JSON=[]
# Example:
# YFY_ACCESS_CONTEXTS_JSON=[{"id":"reviewer","user_id":"530","external_enterprise_id":"9"}]
YFY_SCOPES_JSON=[]
# Example:
# YFY_SCOPES_JSON=[{"id":"tender_public","root_folder_id":"501000715605","access_context":"default","tags":["tender","public-material"]}]

# Provider request controls.
YFY_REQUEST_TIMEOUT_MS=30000
YFY_TOKEN_REFRESH_SKEW_SECONDS=300
YFY_MAX_PAGE_CAPACITY=500
YFY_RETRY_MAX_ATTEMPTS=3
YFY_RETRY_BASE_DELAY_MS=500
YFY_MAX_RETRY_DELAY_MS=30000
YFY_MAX_CONCURRENT_PROVIDER_REQUESTS=4
YFY_MAX_CONCURRENT_REQUESTS_PER_IDENTITY=2

# SQLite snapshot state and local evidence storage.
YFY_STATE_DB=
YFY_SNAPSHOT_CONCURRENCY=2
YFY_SNAPSHOT_TTL_SECONDS=604800
YFY_MAX_STATE_BYTES=2147483648
YFY_TEMP_DIR=
YFY_TEMP_FILE_TTL_SECONDS=86400
YFY_MAX_DOWNLOAD_BYTES=268435456
YFY_MAX_EVIDENCE_RESOURCE_BYTES=16777216
YFY_MAX_TEMP_BYTES=1073741824
YFY_DOWNLOAD_IDLE_TIMEOUT_MS=30000
YFY_DOWNLOAD_WALL_TIMEOUT_MS=300000
YFY_ALLOW_PRIVATE_TRANSFER_URLS=disabled
YFY_UPLOAD_ROOT_DIR=

# Transport. stdio remains the default.
YFY_TRANSPORT=stdio
YFY_HTTP_HOST=127.0.0.1
YFY_HTTP_PORT=3000
YFY_HTTP_MAX_SESSIONS=100
YFY_HTTP_SESSION_IDLE_SECONDS=1800
YFY_HTTP_BEARER_TOKEN=
YFY_HTTP_ALLOWED_HOSTS=
YFY_HTTP_ALLOWED_ORIGINS=
YFY_LOG_LEVEL=info

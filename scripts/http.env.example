# 复制为脚本同目录 .env 后填写真实值：
#   copy scripts\http.env.example scripts\.env     (Windows)
#   cp scripts/http.env.example scripts/.env       (macOS / Linux)
#
# 或通过参数指定任意路径：
#   node scripts/start-npx.mjs --env-file /path/to/http.env
#
# 服务只读进程环境变量；本文件由 scripts/start-npx.mjs 加载后注入子进程。
# 格式：KEY=VALUE；# 整行注释；未加引号值可用「 #」行内注释；UTF-8 可带 BOM。
# 合并：shell 中非空变量优先；空串或未设置可由本文件补全。

# ---------- 必填：亿方云身份 ----------
YFY_CLIENT_ID=
YFY_CLIENT_SECRET=
YFY_ENTERPRISE_ID=
YFY_DEFAULT_USER_ID=

# 私有化时取消注释并改为实际地址（非 localhost 须 HTTPS）
# YFY_API_BASE_URL=https://open.fangcloud.com/api
# YFY_OAUTH_BASE_URL=https://open.fangcloud.com

# ---------- 能力（按需） ----------
YFY_TOOLSETS=drive
# YFY_TOOLSETS=drive,workspace,inventory
# YFY_WORKFLOW_PROFILES=tender
# YFY_WORKSPACES_JSON=[{"id":"tender_public","root_folder_id":"501000000000","access_context":"default","tags":["tender"]}]

# ---------- HTTP 传输（本机开发） ----------
YFY_TRANSPORT=http
YFY_HTTP_HOST=127.0.0.1
YFY_HTTP_PORT=3000

# 下载交付：HTTP 默认 staged fetch_url；stdio 才需要 local_path
YFY_DOWNLOAD_EXPOSE_LOCAL_PATH=disabled
YFY_DOWNLOAD_STAGED_HTTP=enabled

# ---------- 生产 / 对外（非回环或远程 public base 时必填） ----------
# YFY_HTTP_BEARER_TOKEN=replace-with-a-long-random-token
# YFY_HTTP_ALLOWED_HOSTS=mcp.example.com
# YFY_HTTP_ALLOWED_ORIGINS=https://agent.example.com
# YFY_DOWNLOAD_STAGED_PUBLIC_BASE_URL=https://mcp.example.com

# ---------- 可选持久化 ----------
# YFY_TEMP_DIR=
# YFY_STATE_DB=

YFY_LOG_LEVEL=info

{
  "name": "yifangyun-mcp-server",
  "version": "1.0.0-beta.4",
  "description": "MCP server for Yifangyun cloud drive access with enterprise JWT authentication.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrhegit/yifangyun-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yifangyun",
    "fangcloud",
    "cloud-drive"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "yifangyun-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    ".env.example"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:compile": "node scripts/clean.mjs dist-test && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test dist-test/*.test.js",
    "test:perf": "npm run test:compile && node scripts/perf-test.mjs",
    "check": "npm run build && npm test && npm run test:perf",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "undici": "^7.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
